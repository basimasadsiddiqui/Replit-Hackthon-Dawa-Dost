# Copy to .env for local dev (npm run dev). On Render, set these in the dashboard instead.
# Everything here has a FREE tier. You need at least one of GEMINI_API_KEY / GROQ_API_KEY.
# After deploying, open  /api/selftest?key=YOUR_ADMIN_KEY  to see exactly which provider/model works.

# Google Gemini (free): vision reader, pharmacist + chat agents, and voice. Key: aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides. Models are tried in order, so a rate-limited one falls through to the next.
# (gemini-2.5-flash is deprecated; Google reroutes it on 2026-12-01.)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
# auto = try the new Interactions API, fall back to legacy generateContent
GEMINI_API_MODE=auto

# Groq (free): automatic backup when Gemini is rate-limited. Key: console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: Azure Speech free tier (best Urdu voice). Used only if Gemini voice fails.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# protects the Live Room reset button and /api/selftest
ADMIN_KEY=
